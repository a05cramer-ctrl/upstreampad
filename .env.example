# Set these in Vercel -> Project -> Settings -> Environment Variables. Never commit real values.
# Helius mainnet RPC key (https://dashboard.helius.dev)
HELIUS_API_KEY=
# 64+ random hex chars. Derives every repo vault: HMAC-SHA256(secret, "upstream:"+repoId).
# NEVER change it after the first launch, or every vault address changes. Back it up offline.
VAULT_MASTER_SECRET=
# GitHub OAuth App (Settings -> Developer settings -> OAuth Apps).
# Callback URL: https://<your-domain>/api/auth-callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# 64+ random hex chars, seals the session cookie and launch tickets
SESSION_SECRET=
# 1 = /api/claim only simulates and returns the simulation. Set to 0 after one small live test claim.
DRY_RUN=1
